{
  "name": "edgedesk",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless internal People-Ops request desk on the Cloudflare developer platform",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "migrate": "pnpm --filter api migrate:local",
    "seed": "pnpm --filter api seed",
    "test": "pnpm --filter api test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "build": "pnpm --filter web build",
    "eval": "pnpm --filter api eval",
    "bench": "pnpm --filter api bench"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.16.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "yaml": "^2.6.1"
  }
}
